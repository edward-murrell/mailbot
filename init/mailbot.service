[Unit]
Description=mailbot contact form relay
Documentation=https://github.com/edward-murrell/mailbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mailbot
# Values in the EnvironmentFile override these defaults.
Environment=STORAGE_DIR=/var/lib/mailbot
EnvironmentFile=/etc/mailbot/mailbot.env
DynamicUser=yes
StateDirectory=mailbot
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5s
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
