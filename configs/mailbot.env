# mailbot configuration, read by the mailbot systemd service.
# Restart after changes: systemctl restart mailbot

# Bind to loopback only. Your reverse proxy forwards to this address.
LISTEN_ADDR=127.0.0.1:8080

# Only these peers may set X-Real-IP and X-Forwarded-For.
# Add your proxy's address if it runs on another host.
TRUSTED_PROXIES=127.0.0.1,::1

# SMTP. Set SMTP_ENABLED=false to only write submissions to disk.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Submissions go to /var/lib/mailbot by default. Changing this also needs
# ReadWritePaths= in a systemd drop-in, because the service runs with
# ProtectSystem=strict.
#STORAGE_DIR=/var/lib/mailbot

# Minimum seconds between submissions from one IP.
RATE_LIMIT_INTERVAL=5

# debug, info, warn or error
LOG_LEVEL=info
